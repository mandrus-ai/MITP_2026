#---------------------------------------------------------------------------
# Project
#---------------------------------------------------------------------------

DOXYFILE_ENCODING      = UTF-8

PROJECT_NAME           = "Edinobogic"
PROJECT_BRIEF          = "Qt client-server educational project"
PROJECT_NUMBER         = 1.0

OUTPUT_DIRECTORY       = docs
CREATE_SUBDIRS         = YES
OUTPUT_LANGUAGE        = Russian

FULL_PATH_NAMES        = NO

#---------------------------------------------------------------------------
# Input
#---------------------------------------------------------------------------

INPUT                  = AuthClient \
                         ConsoleClient \
                         echoServer

FILE_PATTERNS          = *.cpp \
                         *.h \
                         *.hpp

RECURSIVE              = YES

EXCLUDE                = build \
                         cmake-build-debug \
                         cmake-build-release \
                         docs

EXCLUDE_PATTERNS       = */ui_* \
                         */moc_* \
                         */qrc_* \
                         */.git/*

INPUT_ENCODING         = UTF-8

#---------------------------------------------------------------------------
# Extraction
#---------------------------------------------------------------------------

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES

HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO

#---------------------------------------------------------------------------
# Build
#---------------------------------------------------------------------------

MARKDOWN_SUPPORT       = YES
USE_MDFILE_AS_MAINPAGE = README.md

SOURCE_BROWSER         = YES
INLINE_SOURCES         = YES

REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES

#---------------------------------------------------------------------------
# Qt
#---------------------------------------------------------------------------

ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = NO

PREDEFINED             += Q_OBJECT
PREDEFINED             += signals=public
PREDEFINED             += slots=
PREDEFINED             += emit=
PREDEFINED             += foreach=for

#---------------------------------------------------------------------------
# HTML
#---------------------------------------------------------------------------

GENERATE_HTML          = YES
HTML_OUTPUT            = html

GENERATE_TREEVIEW      = YES

HTML_DYNAMIC_MENUS     = YES
HTML_DYNAMIC_SECTIONS  = YES

SEARCHENGINE           = YES

HTML_COLORSTYLE        = AUTO_DARK

#---------------------------------------------------------------------------
# Graphviz / UML
#---------------------------------------------------------------------------

HAVE_DOT               = YES

DOT_NUM_THREADS        = 4

CLASS_DIAGRAMS         = YES
COLLABORATION_GRAPH    = YES
CALL_GRAPH             = YES
CALLER_GRAPH           = YES
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = YES

UML_LOOK               = YES
UML_LIMIT_NUM_FIELDS   = 50

DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES

DOT_MULTI_TARGETS      = YES

GENERATE_LEGEND        = YES
DOT_CLEANUP            = YES

#---------------------------------------------------------------------------
# Output
#---------------------------------------------------------------------------

GENERATE_LATEX         = NO
GENERATE_XML           = NO

#---------------------------------------------------------------------------
# Warnings
#---------------------------------------------------------------------------

QUIET                  = NO
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO

#---------------------------------------------------------------------------
# Misc
#---------------------------------------------------------------------------

SORT_MEMBER_DOCS       = YES
SORT_BRIEF_DOCS        = YES

ALPHABETICAL_INDEX     = YES

TAB_SIZE               = 4

CASE_SENSE_NAMES       = NO